# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Under Construction Mode
# Set to 'true' to show the under construction page to visitors
# Set to 'false' to show the full website
# For production deployment: set to 'true' until ready to launch
# For local development: create .env.local and set to 'false'
VITE_UNDER_CONSTRUCTION=true
